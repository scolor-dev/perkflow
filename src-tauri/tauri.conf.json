{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "PerkFlow",
    "version":  "0.1.1",
    "identifier":  "com.perkflow.dev",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "PerkFlow",
                                    "width":  1000,
                                    "height":  700,
                                    "minWidth":  800,
                                    "minHeight":  550,
                                    "resizable":  true,
                                    "decorations":  true,
                                    "transparent":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "wix":  {
                                               "language":  "ja-JP"
                                           }
                               }
               }
}